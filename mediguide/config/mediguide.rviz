Panels:
  - Class: rviz/Displays
    Name: Displays
    Help Height: 0
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Alpha: 0.3
      Reference Frame: <Fixed Frame>
    - Class: rviz/Map
      Name: Hospital Map
      Enabled: true
      Topic: /map
      Alpha: 0.8
      Color Scheme: map
      Draw Behind: false
    - Class: rviz/Map
      Name: Costmap
      Enabled: true
      Topic: /move_base/global_costmap/costmap
      Alpha: 0.4
      Color Scheme: costmap
      Draw Behind: true
    - Class: rviz/RobotModel
      Name: Robot
      Enabled: true
      Robot Description: robot_description
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz/LaserScan
      Name: Laser
      Enabled: true
      Topic: /scan
      Size (m): 0.04
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 0; 0
    - Class: rviz/Path
      Name: Planned Path
      Enabled: true
      Topic: /move_base/NavfnROS/plan
      Color: 0; 120; 255
      Line Style: Lines
    - Class: rviz/MarkerArray
      Name: Stations
      Enabled: true
      Marker Topic: /stations
    - Class: rviz/PoseArray
      Name: AMCL Particles
      Enabled: false
      Topic: /particlecloud
  Enabled: true
  Global Options:
    Background Color: 245; 245; 245
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      X: 7.5
      Y: 1.5
      Scale: 45
      Angle: 0
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
  Displays:
    collapsed: false
