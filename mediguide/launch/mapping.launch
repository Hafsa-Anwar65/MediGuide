<launch>
  <!-- Make a map of the hospital with gmapping.
       Drive the robot with:  rosrun teleop_twist_keyboard teleop_twist_keyboard.py
       Save the map with:     rosrun map_server map_saver -f ~/hospital_gmapping -->
  <arg name="model" default="burger"/>

  <include file="$(find mediguide)/launch/simworld.launch">
    <arg name="model" value="$(arg model)"/>
  </include>

  <include file="$(find turtlebot3_slam)/launch/turtlebot3_slam.launch">
    <arg name="model" value="$(arg model)"/>
    <arg name="slam_methods" value="gmapping"/>
    <arg name="open_rviz" value="true"/>
  </include>
</launch>
